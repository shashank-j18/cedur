# YourBrand Backend Environment Variables
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5173

# Neon Serverless PostgreSQL Connection String (from https://console.neon.tech)
# Example: postgresql://youruser:yourpassword@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Session / JWT Secret (replace with 32+ character random string in production)
JWT_SECRET=your-random-32-character-secret-key-for-sessions
